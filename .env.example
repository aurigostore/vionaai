# === Telegram ===
# Token dari @BotFather
TELEGRAM_BOT_TOKEN=
# ID Telegram kamu dari @userinfobot (pisahkan koma kalau lebih dari satu)
ALLOWED_USER_IDS=

# === AI (endpoint Anthropic-compatible) ===
AI_BASE_URL=https://api.rindri.com
AI_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (kosongkan kalau provider menolak parameter effort)
AI_EFFORT=medium
AI_MAX_TOKENS=16000

# === Lain-lain ===
TIMEZONE=Asia/Jakarta
HISTORY_LIMIT=40
